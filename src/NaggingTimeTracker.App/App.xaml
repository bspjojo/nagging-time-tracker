<Application x:Class="NaggingTimeTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="ParallelBrush" Color="#B07800" />
        <SolidColorBrush x:Key="ParallelBackgroundBrush" Color="#FFF4D6" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#6B6B6B" />

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Application.Resources>
</Application>
