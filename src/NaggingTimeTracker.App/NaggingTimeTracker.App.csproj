<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NaggingTimeTracker</AssemblyName>
    <RootNamespace>NaggingTimeTracker.App</RootNamespace>
    <Version>1.0.1</Version>
    <!-- LibraryImport (GetLastInputInfo, §7.1) needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\tray\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NaggingTimeTracker.Core\NaggingTimeTracker.Core.csproj" />
    <ProjectReference Include="..\NaggingTimeTracker.Data\NaggingTimeTracker.Data.csproj" />
  </ItemGroup>

</Project>
