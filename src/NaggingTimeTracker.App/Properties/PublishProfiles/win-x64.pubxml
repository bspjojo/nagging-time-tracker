<Project>
  <!-- Used by tools/build-installer.ps1: one self-contained exe for the MSI (plan-phase9-installer.md §1). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <DebugType>none</DebugType>
    <!-- Core and Data keep their own DebugType; this stops their .pdb files being copied here. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
