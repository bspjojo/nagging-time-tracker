<Window x:Class="NaggingTimeTracker.App.Windows.ConcurrencyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ConcurrencyDialog"
        Title="Timer already running"
        Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" MinWidth="380" MaxWidth="520">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ItemsControl x:Name="RunningList" AutomationProperties.AutomationId="ConcurrencyDialog.RunningList"
                      Margin="12,6,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,1" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Why are these overlapping? (optional)" Margin="0,0,0,4" />
        <TextBox x:Name="ReasonBox" AutomationProperties.AutomationId="ConcurrencyDialog.ReasonBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Stop others &amp; start" Style="{StaticResource DialogButton}"
                    AutomationProperties.AutomationId="ConcurrencyDialog.StopOthersButton"
                    Click="StopOthers_Click" />
            <Button Content="Run in parallel" Style="{StaticResource DialogButton}" IsDefault="True"
                    AutomationProperties.AutomationId="ConcurrencyDialog.RunInParallelButton"
                    Click="RunInParallel_Click" />
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True"
                    AutomationProperties.AutomationId="ConcurrencyDialog.CancelButton" />
        </StackPanel>
    </StackPanel>
</Window>
