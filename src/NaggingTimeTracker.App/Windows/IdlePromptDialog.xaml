<Window x:Class="NaggingTimeTracker.App.Windows.IdlePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="IdlePrompt"
        Title="Nagging Time Tracker"
        Topmost="True" ShowActivated="True" ShowInTaskbar="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        MinWidth="380" MaxWidth="560">
    <!-- No IsDefault and no initial focus: keys typed on the way back in can't pick an option (§7.2). -->
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="IdlePrompt.Message" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Keep it" Style="{StaticResource DialogButton}" IsCancel="True"
                    AutomationProperties.AutomationId="IdlePrompt.KeepButton"
                    Click="Keep_Click" />
            <Button Content="Discard idle time &amp; continue" Style="{StaticResource DialogButton}"
                    AutomationProperties.AutomationId="IdlePrompt.DiscardContinueButton"
                    Click="DiscardContinue_Click" />
            <Button Content="Discard idle time &amp; stop" Style="{StaticResource DialogButton}"
                    AutomationProperties.AutomationId="IdlePrompt.DiscardStopButton"
                    Click="DiscardStop_Click" />
        </StackPanel>
    </StackPanel>
</Window>
