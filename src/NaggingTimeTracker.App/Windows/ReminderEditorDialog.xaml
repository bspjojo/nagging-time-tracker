<Window x:Class="NaggingTimeTracker.App.Windows.ReminderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="ReminderEditor"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <Label Content="_Title" Target="{Binding ElementName=TitleBox}" Padding="0,0,0,3" />
        <TextBox x:Name="TitleBox" TextChanged="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.TitleBox" />

        <Label Content="_Message (optional)" Target="{Binding ElementName=MessageText}" Padding="0,8,0,3" />
        <TextBox x:Name="MessageText" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.AutomationId="ReminderEditor.MessageBox" />

        <TextBlock Text="Days" Margin="0,8,0,3" />
        <WrapPanel>
            <WrapPanel.Resources>
                <Style TargetType="CheckBox">
                    <Setter Property="Margin" Value="0,0,10,0" />
                </Style>
            </WrapPanel.Resources>
            <CheckBox x:Name="DayMon" Content="Mon" Click="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.DayMon" />
            <CheckBox x:Name="DayTue" Content="Tue" Click="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.DayTue" />
            <CheckBox x:Name="DayWed" Content="Wed" Click="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.DayWed" />
            <CheckBox x:Name="DayThu" Content="Thu" Click="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.DayThu" />
            <CheckBox x:Name="DayFri" Content="Fri" Click="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.DayFri" />
            <CheckBox x:Name="DaySat" Content="Sat" Click="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.DaySat" />
            <CheckBox x:Name="DaySun" Content="Sun" Click="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.DaySun" />
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Label Content="Ti_me" Target="{Binding ElementName=TimeBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
            <TextBox x:Name="TimeBox" Width="60" TextChanged="Field_Changed" AutomationProperties.AutomationId="ReminderEditor.TimeBox" />
        </StackPanel>

        <TextBlock x:Name="HintText" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="ReminderEditor.Hint" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   AutomationProperties.AutomationId="ReminderEditor.Error" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="_Save" IsDefault="True" Style="{StaticResource DialogButton}" Click="Save_Click"
                    AutomationProperties.AutomationId="ReminderEditor.SaveButton" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"
                    AutomationProperties.AutomationId="ReminderEditor.CancelButton" />
        </StackPanel>
    </StackPanel>
</Window>
