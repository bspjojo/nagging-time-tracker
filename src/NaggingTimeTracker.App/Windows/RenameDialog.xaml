<Window x:Class="NaggingTimeTracker.App.Windows.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="RenameDialog"
        ResizeMode="NoResize" SizeToContent="Height" Width="360" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <Label Content="_New name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"
                 AutomationProperties.AutomationId="RenameDialog.NameBox" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="RenameDialog.Error" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"
                    AutomationProperties.AutomationId="RenameDialog.OkButton" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"
                    AutomationProperties.AutomationId="RenameDialog.CancelButton" />
        </StackPanel>
    </StackPanel>
</Window>
