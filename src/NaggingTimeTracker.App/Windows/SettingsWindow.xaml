<Window x:Class="NaggingTimeTracker.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NaggingTimeTracker.App.ViewModels"
        xmlns:windows="clr-namespace:NaggingTimeTracker.App.Windows"
        AutomationProperties.AutomationId="SettingsWindow"
        Title="Settings — Nagging Time Tracker"
        Width="600" Height="460" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <!-- One layout for both catalog tabs; ids come from the view-model's AutomationPrefix
             (TabControl hosts the content outside the TabItem, so the tab can't supply them). -->
        <DataTemplate x:Key="CatalogTab" DataType="{x:Type vm:CatalogListViewModel}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="110">
                    <Button Content="_Rename…" Command="{Binding RenameCommand}" Padding="8,3" Margin="0,0,0,6"
                            AutomationProperties.AutomationId="{Binding AutomationPrefix, StringFormat={}SettingsWindow.{0}RenameButton}" />
                    <Button Content="{Binding ArchiveLabel}" Command="{Binding ToggleArchiveCommand}" Padding="8,3"
                            AutomationProperties.AutomationId="{Binding AutomationPrefix, StringFormat={}SettingsWindow.{0}ArchiveButton}" />
                </StackPanel>
                <CheckBox DockPanel.Dock="Bottom" Content="Show archived" IsChecked="{Binding ShowArchived}" Margin="0,8,0,0"
                          AutomationProperties.AutomationId="{Binding AutomationPrefix, StringFormat={}SettingsWindow.{0}sShowArchived}" />
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label"
                         AutomationProperties.AutomationId="{Binding AutomationPrefix, StringFormat={}SettingsWindow.{0}sList}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- Screen readers and UI tests see the label, not the record's ToString. -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Archived}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="8" AutomationProperties.AutomationId="SettingsWindow.Tabs">
        <!-- General (§8): Start with Windows applies at once. -->
        <TabItem Header="General" Tag="{x:Static windows:SettingsTab.General}" DataContext="{Binding General}"
                 AutomationProperties.AutomationId="SettingsWindow.GeneralTab">
            <StackPanel Margin="12">
                <CheckBox Content="_Start Nagging Time Tracker when I sign in to Windows" IsChecked="{Binding StartWithWindows}"
                          IsEnabled="{Binding CanChangeStartWithWindows}"
                          AutomationProperties.AutomationId="SettingsWindow.StartWithWindows" />
                <TextBlock Text="Only available when using the default data folder." Margin="20,4,0,0" TextWrapping="Wrap"
                           Foreground="{x:Static SystemColors.GrayTextBrush}"
                           AutomationProperties.AutomationId="SettingsWindow.StartWithWindowsHint">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanChangeStartWithWindows}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Label Content="_Data folder:" Target="{Binding ElementName=DataFolderBox}" Padding="0" Margin="0,16,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="_Open data folder" Command="{Binding OpenDataFolderCommand}"
                            Padding="8,3" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="SettingsWindow.OpenDataFolderButton" />
                    <TextBox x:Name="DataFolderBox" Text="{Binding DataFolder, Mode=OneWay}" IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="SettingsWindow.DataFolder" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{x:Static SystemColors.GrayTextBrush}"
                           Text="Your entries are in tracker.db. A backup is made each day you use the app; the last 7 are kept in the backups folder." />
                <TextBlock Text="{Binding GeneralError}" Foreground="{StaticResource ErrorBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsWindow.GeneralError" />
            </StackPanel>
        </TabItem>

        <!-- Work hours: the not-tracking reminder (§6.1). Changes apply when a field loses focus. -->
        <TabItem Header="Work hours" Tag="{x:Static windows:SettingsTab.WorkHours}" DataContext="{Binding Reminder}"
                 AutomationProperties.AutomationId="SettingsWindow.WorkHoursTab">
            <StackPanel Margin="12">
                <TextBlock Text="Work days" Margin="0,0,0,4" />
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="CheckBox">
                            <Setter Property="Margin" Value="0,0,12,0" />
                        </Style>
                    </WrapPanel.Resources>
                    <CheckBox Content="Mon" IsChecked="{Binding Mon}" AutomationProperties.AutomationId="SettingsWindow.WorkDayMon" />
                    <CheckBox Content="Tue" IsChecked="{Binding Tue}" AutomationProperties.AutomationId="SettingsWindow.WorkDayTue" />
                    <CheckBox Content="Wed" IsChecked="{Binding Wed}" AutomationProperties.AutomationId="SettingsWindow.WorkDayWed" />
                    <CheckBox Content="Thu" IsChecked="{Binding Thu}" AutomationProperties.AutomationId="SettingsWindow.WorkDayThu" />
                    <CheckBox Content="Fri" IsChecked="{Binding Fri}" AutomationProperties.AutomationId="SettingsWindow.WorkDayFri" />
                    <CheckBox Content="Sat" IsChecked="{Binding Sat}" AutomationProperties.AutomationId="SettingsWindow.WorkDaySat" />
                    <CheckBox Content="Sun" IsChecked="{Binding Sun}" AutomationProperties.AutomationId="SettingsWindow.WorkDaySun" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Label Content="_From" Target="{Binding ElementName=WorkStartBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="WorkStartBox" Width="60" Text="{Binding WorkStartText}"
                             AutomationProperties.AutomationId="SettingsWindow.WorkStart" />
                    <Label Content="_to" Target="{Binding ElementName=WorkEndBox}" Padding="10,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="WorkEndBox" Width="60" Text="{Binding WorkEndText}"
                             AutomationProperties.AutomationId="SettingsWindow.WorkEnd" />
                    <TextBlock Text="{Binding WorkHoursHint}" Foreground="{StaticResource SubtleBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="SettingsWindow.OvernightHint" />
                </StackPanel>
                <CheckBox Content="_Remind me when I'm not tracking anything during work hours" Margin="0,14,0,0"
                          IsChecked="{Binding NotTrackingEnabled}" AutomationProperties.AutomationId="SettingsWindow.NotTrackingEnabled" />
                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                    <Label Content="_Every" Target="{Binding ElementName=NotTrackingIntervalBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="NotTrackingIntervalBox" Width="50" Text="{Binding NotTrackingIntervalText}"
                             AutomationProperties.AutomationId="SettingsWindow.NotTrackingInterval" />
                    <TextBlock Text="minutes" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding WorkHoursError}" Foreground="{StaticResource ErrorBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsWindow.WorkHoursError" />
            </StackPanel>
        </TabItem>

        <!-- Check-ins (§6.2) -->
        <TabItem Header="Check-ins" Tag="{x:Static windows:SettingsTab.CheckIns}" DataContext="{Binding Reminder}"
                 AutomationProperties.AutomationId="SettingsWindow.CheckInsTab">
            <StackPanel Margin="12">
                <CheckBox Content="_Ask &quot;Still working on …?&quot; while a timer runs" IsChecked="{Binding CheckInEnabled}"
                          AutomationProperties.AutomationId="SettingsWindow.CheckInEnabled" />
                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                    <Label Content="_Every" Target="{Binding ElementName=CheckInIntervalBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="CheckInIntervalBox" Width="50" Text="{Binding CheckInIntervalText}"
                             AutomationProperties.AutomationId="SettingsWindow.CheckInInterval" />
                    <TextBlock Text="minutes" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding CheckInsError}" Foreground="{StaticResource ErrorBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsWindow.CheckInsError" />
            </StackPanel>
        </TabItem>

        <!-- Idle (§7) -->
        <TabItem Header="Idle" Tag="{x:Static windows:SettingsTab.Idle}" DataContext="{Binding Reminder}"
                 AutomationProperties.AutomationId="SettingsWindow.IdleTab">
            <StackPanel Margin="12">
                <CheckBox Content="_Ask what to do with the time when I come back from being away" IsChecked="{Binding IdleEnabled}"
                          AutomationProperties.AutomationId="SettingsWindow.IdleEnabled" />
                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                    <Label Content="Away _after" Target="{Binding ElementName=IdleThresholdBox}" Padding="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="IdleThresholdBox" Width="50" Text="{Binding IdleThresholdText}"
                             AutomationProperties.AutomationId="SettingsWindow.IdleThreshold" />
                    <TextBlock Text="minutes without keyboard or mouse input" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Locking the PC or putting it to sleep also counts as away." Margin="20,6,0,0" TextWrapping="Wrap"
                           Foreground="{x:Static SystemColors.GrayTextBrush}" />
                <TextBlock Text="{Binding IdleError}" Foreground="{StaticResource ErrorBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SettingsWindow.IdleError" />
            </StackPanel>
        </TabItem>

        <!-- Custom reminders (§6.3) -->
        <TabItem Header="Reminders" Tag="{x:Static windows:SettingsTab.Reminders}" DataContext="{Binding Scheduled}"
                 AutomationProperties.AutomationId="SettingsWindow.RemindersTab">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="110">
                    <Button Content="_Add…" Command="{Binding AddCommand}" Padding="8,3" Margin="0,0,0,6"
                            AutomationProperties.AutomationId="SettingsWindow.ReminderAddButton" />
                    <Button Content="_Edit…" Command="{Binding EditCommand}" Padding="8,3" Margin="0,0,0,6"
                            AutomationProperties.AutomationId="SettingsWindow.ReminderEditButton" />
                    <Button Content="_Delete" Command="{Binding DeleteCommand}" Padding="8,3"
                            AutomationProperties.AutomationId="SettingsWindow.ReminderDeleteButton" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                          SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" MouseDoubleClick="RemindersGrid_MouseDoubleClick"
                          HorizontalGridLinesBrush="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                          AutomationProperties.AutomationId="SettingsWindow.RemindersGrid">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              AutomationProperties.Name="Enabled" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="55" IsReadOnly="True" />
                        <DataGridTextColumn Header="Days" Binding="{Binding Days}" Width="110" IsReadOnly="True" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Customers" Tag="{x:Static windows:SettingsTab.Customers}"
                 AutomationProperties.AutomationId="SettingsWindow.CustomersTab"
                 Content="{Binding Customers}" ContentTemplate="{StaticResource CatalogTab}" />
        <TabItem Header="Task types" Tag="{x:Static windows:SettingsTab.TaskTypes}"
                 AutomationProperties.AutomationId="SettingsWindow.TaskTypesTab"
                 Content="{Binding TaskTypes}" ContentTemplate="{StaticResource CatalogTab}" />
    </TabControl>
</Window>
