<Window x:Class="NaggingTimeTracker.App.Windows.TooShortDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="TooShortDialog"
        Title="Very short entry"
        Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False" MinWidth="340" MaxWidth="480">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Discard" Style="{StaticResource DialogButton}"
                    AutomationProperties.AutomationId="TooShortDialog.DiscardButton"
                    Click="Discard_Click" />
            <Button Content="Keep" Style="{StaticResource DialogButton}" IsDefault="True" IsCancel="True"
                    AutomationProperties.AutomationId="TooShortDialog.KeepButton" />
        </StackPanel>
    </StackPanel>
</Window>
