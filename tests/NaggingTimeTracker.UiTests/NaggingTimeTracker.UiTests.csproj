<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The exe these tests drive, for this build configuration (AppFixture reads it). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppExe</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\src\NaggingTimeTracker.App\bin\$(Configuration)\net10.0-windows\NaggingTimeTracker.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Built first so the exe exists; not referenced as an assembly. -->
    <ProjectReference Include="..\..\src\NaggingTimeTracker.App\NaggingTimeTracker.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NaggingTimeTracker.Data\NaggingTimeTracker.Data.csproj" />
  </ItemGroup>

</Project>
